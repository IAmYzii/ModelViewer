{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Viewer",
  "version": "0.2.0",
  "identifier": "app.modelviewer.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Model Viewer",
        "url": "viewer.html",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#1c1e22",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
