{
  "name": "model-viewer",
  "productName": "Model Viewer",
  "version": "0.1.0",
  "description": "Quick viewer for FBX and OBJ files",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . ModelViewer --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=^/test --ignore=^/dist --ignore=^/\\.claude --ignore=\\.ps1$"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1"
  }
}
